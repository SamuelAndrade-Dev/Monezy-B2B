rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validTransaction(d) {
      return d.keys().hasAll(['title','amount','category','type','date']) &&
        d.title is string && d.title.size() > 0 && d.title.size() <= 160 &&
        d.amount is number && d.amount > 0 && d.amount <= 1000000 &&
        d.category is string && d.category.size() <= 80 &&
        d.type in ['expense','credit'] && d.date is timestamp;
    }
    match /users/{uid}/accounts/{accountId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && accountId == 'main' &&
        request.resource.data.limitTotal == 10000 &&
        request.resource.data.companyId == uid &&
        request.resource.data.currency == 'BRL' &&
        request.resource.data.demo == true;
      allow update, delete: if false;
    }
    match /users/{uid}/transactions/{txId} {
      allow read: if owner(uid);
      allow create: if owner(uid) && validTransaction(request.resource.data);
      allow update: if owner(uid) && validTransaction(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
